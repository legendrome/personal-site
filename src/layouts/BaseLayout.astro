---
// The whole site is one ocean, and each page opens at its own depth. "opening" says how:
// - dive: sky and boat fill the first screen, then the water, which is the home page.
// - deck: the page's content is in the sky, on the boat, with only the footer in the water.
// - water: no sky, because the page starts below the surface.
// Pages fill in "surface" for what sits above the water, the default slot for everything
// below it, and "underwater" for scenery behind that, such as the home page's anchor line.
// "water" sets the page's own gradient, to keep it at its depth.
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import BackToDive from '../components/BackToDive.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/tokens.css';

interface Props {
	title: string;
	// What search results and link previews show. Falls back to the site's own description.
	description?: string;
	opening?: 'dive' | 'deck' | 'water';
	water?: string;
	// The boat small and far away, for the page-not-found page.
	adrift?: boolean;
}

const { title, description, opening = 'dive', water, adrift = false } = Astro.props;
const { data: site } = await getEntry('site', 'site');
const summary = description ?? site.description;
const address = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-unbounded" preload />
		<Font cssVariable="--font-karla" preload />
		<title>{title}</title>
		<meta name="description" content={summary} />
		<link rel="canonical" href={address} />
		<link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={summary} />
		<meta property="og:url" content={address} />
		<meta property="og:image" content={new URL('/preview.png', Astro.site).href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="A small sailing boat on blue waves under a pale sky" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body id="top">
		<a class="skip-link" href="#main">{site.skipLink}</a>
		{
			opening !== 'water' && (
				<div class="surface">
					<SiteHeader tone="sky" />
					<div class="above-boat">
						<div class="sky-bar" />
						<div class="inner">
							{opening === 'deck' ? (
								<main id="main" tabindex="-1">
									<slot name="surface" />
								</main>
							) : (
								<slot name="surface" />
							)}
						</div>
					</div>
					<svg
						class:list={['boat', { adrift }]}
						viewBox="0 0 120 90"
						role="img"
						aria-label="A small sailing boat"
					>
						<path d="M58 6 V62 H18 Z" />
						<path d="M64 18 V62 H98 Z" />
						<path d="M6 66 H114 L98 88 H22 Z" />
					</svg>
					<svg class="wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
						<path d="M0 40 C 180 10, 360 70, 540 40 S 900 10, 1080 40 S 1320 70, 1440 36 V90 H0 Z" />
					</svg>
					<slot name="at-waterline" />
				</div>
			)
		}

		<div
			class:list={['sea', { 'no-sky': opening === 'water' }]}
			style={water ? `--water-gradient: ${water}` : undefined}
		>
			<SiteHeader tone="water" />
			<slot name="underwater" />
			{
				opening !== 'deck' && (
					<main id="main" class="inner" tabindex="-1">
						<slot />
					</main>
				)
			}
			<footer class="inner">
				{/* A water page has no boat of its own, so it returns to the spot left on the home page. */}
				{opening === 'water' ? <BackToDive /> : <a href="#top">{site.backUp}</a>}
				<div class="foot">
					<span>{site.name}</span>
					<div class="links">
						{site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
						<a href={site.github}>GitHub</a>
						<a href="/rss.xml">RSS</a>
					</div>
				</div>
			</footer>
			<slot name="seafloor" />
		</div>

		<!-- Outside the sky and water, whose clip-paths would otherwise cut off anything fixed
		     to the screen. The home page puts its year marker here. -->
		<slot name="overlay" />

		<script>
			// Tells the water header where the water is on screen, so its copy of the gradient
			// lines up with the real one. Without this script it just stays one shade of blue.
			const sea = document.querySelector('.sea');
			const skyHeader = document.querySelector('.site-header.sky');
			const waterHeader = document.querySelector('.site-header.water');

			function lineUpHeader() {
				const { top, height } = sea.getBoundingClientRect();
				sea.style.setProperty('--sea-top', `${top}px`);
				sea.style.setProperty('--sea-height', `${height}px`);

				// Pulling a phone past the end of a page shows the page's background colour. That
				// is the sea floor, which suits the bottom but would look wrong above the sky.
				const atSurface = Boolean(skyHeader) && scrollY < innerHeight / 2;
				document.documentElement.classList.toggle('at-surface', atSurface);

				// Only the copy in view stays reachable, so keyboard and screen reader users
				// meet the links once, and never land on a link they cannot see. Switching one
				// copy off for good would not work, as each is out of sight for part of the page.
				// Without this script both stay on, which repeats the links but loses nothing.
				// A page with no sky has only the one copy, so there is nothing to switch.
				if (!skyHeader) return;
				const headerInWater = top < skyHeader.offsetHeight / 2;
				skyHeader.inert = headerInWater;
				waterHeader.inert = !headerInWater;
			}

			addEventListener('scroll', lineUpHeader, { passive: true });
			new ResizeObserver(lineUpHeader).observe(sea);
			lineUpHeader();
		</script>
	</body>
</html>

<style is:global>
	html {
		background: var(--colour-water-floor);
		/* Stops the fixed header covering whatever a link or the Tab key jumps to. */
		scroll-padding-top: calc(var(--header-height) + var(--space-small));
	}

	html.at-surface {
		background: var(--colour-sky);
	}

	/* Selected text swaps the colours of whatever is around it, so it stays part of the sea. */
	::selection {
		background: var(--colour-on-water);
		color: var(--colour-water-deep);
	}

	.surface ::selection {
		background: var(--colour-on-sky);
		color: var(--colour-sky);
	}

	body {
		margin: 0;
		color: var(--colour-on-water);
		font: 400 var(--size-text) / 1.6 var(--font-text);
	}

	h1,
	h2,
	h3 {
		margin: 0;
		font-family: var(--font-title);
		font-weight: 800;
		line-height: 1.05;
		text-wrap: balance;
	}

	h1 {
		font-size: var(--size-title);
		/* A long word in a wide font could otherwise push a phone screen sideways. */
		overflow-wrap: break-word;
	}

	h2 {
		font-size: var(--size-chapter);
	}

	p {
		margin: 0;
		max-width: var(--line-length);
	}

	:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}

	/* Only people who have not asked for less motion get movement. */
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}

		/* A soft fade between pages. Browsers without this feature just change page normally. */
		@view-transition {
			navigation: auto;
		}
	}
</style>

<style>
	/* Everything starts at the same left edge as the name in the header. */
	.inner {
		padding-inline: var(--page-gutter);
	}

	.surface {
		position: relative;
		background: var(--colour-sky);
		color: var(--colour-on-sky);
		padding-bottom: var(--surface-bottom);
		/* The sky fills the first screen, so the page opens on the boat with the water below it. */
		min-height: 100svh;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		/* Limits this area's fixed header to this area. See SiteHeader.astro. The bottom edge
		   stops part way up the waves, so the text changes colour as it enters the water. */
		clip-path: inset(0 0 var(--waterline-overlap) 0);
	}

	/* Stretches down to the boat, so the solid bar stays until just before reaching it. */
	.above-boat {
		flex: 1;
	}

	/* The solid bar sticks only inside this block, which ends just above the boat. */
	.sky-bar {
		position: sticky;
		top: 0;
		z-index: 4;
		height: var(--header-height);
		background: var(--colour-sky);
	}

	.boat {
		position: absolute;
		z-index: 1;
		left: 12%;
		/* Low enough that the waves, drawn in front, cover the bottom of the hull. */
		bottom: calc(var(--wave-height) * 0.45);
		width: var(--boat-width);
		height: auto;
		fill: var(--colour-on-sky);
	}

	.boat.adrift {
		left: auto;
		right: 8%;
		width: var(--boat-width-adrift);
	}

	.wave {
		position: absolute;
		z-index: 2;
		left: 0;
		bottom: -1px;
		width: 100%;
		height: var(--wave-height);
		fill: var(--colour-water-shallow);
	}

	/* One unbroken gradient, because lines between chapters broke the feeling of a single dive. */
	.sea {
		position: relative;
		/* One pixel more than the sky's clip, because where the two meet at a fraction of a
		   pixel the browser blends the edges into a faint pale line. */
		margin-top: calc(var(--waterline-overlap) * -1 - 1px);
		padding-top: calc(var(--waterline-overlap) + 1px);
		background: var(--water-gradient);
		/* Limits this area's fixed header to this area. See SiteHeader.astro. */
		clip-path: inset(0);
	}

	/* With no sky above, there are no waves to tuck under, only the header to clear. */
	.sea.no-sky {
		margin-top: 0;
		padding-top: var(--header-height);
	}

	/* Off screen until a keyboard user tabs to it, as the first thing on every page. It sits
	   outside the sky and water, whose clip-paths would otherwise cut it off. */
	.skip-link {
		position: fixed;
		z-index: 20;
		top: var(--space-tiny);
		left: var(--space-tiny);
		padding: var(--space-tiny) var(--space-small);
		border-radius: var(--radius);
		background: var(--colour-on-sky);
		color: var(--colour-on-water);
		font-weight: 500;
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}

	/* The skip link moves focus here, where an outline around the whole page would only distract. */
	main:focus {
		outline: none;
	}

	footer {
		/* Keeps the links in front of any underwater scenery. */
		position: relative;
		display: grid;
		gap: var(--space-large);
		padding-block: var(--space-large) var(--space-huge);
	}

	footer a {
		color: inherit;
		font-weight: 500;
		text-underline-offset: 4px;
	}

	footer > a {
		justify-self: start;
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-small);
	}

	.links {
		display: flex;
		gap: var(--space-small);
	}

	@media (prefers-reduced-motion: no-preference) {
		.boat {
			animation: bob 5s ease-in-out infinite;
			transform-origin: center bottom;
		}

		@keyframes bob {
			0%,
			100% {
				transform: translateY(0) rotate(-1.5deg);
			}

			50% {
				transform: translateY(5px) rotate(1.5deg);
			}
		}
	}
</style>
