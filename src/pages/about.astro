---
// About sits above the water, on the boat, because it is about who Sujith is right now.
// It has two parts: who he is (the writing in about.md, his languages and interests),
// then what he has done, chapter by chapter, newest first.
import { getEntry, render } from 'astro:content';
import ChapterTimeline from '../components/ChapterTimeline.astro';
import PageHead from '../components/PageHead.astro';
import Reading from '../components/Reading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('about', 'about');
const { data: site } = await getEntry('site', 'site');
const { Content } = await render(about);
const page = about.data;
---

<BaseLayout
	title={`${page.title} | ${site.name}`}
	description={page.description}
	opening="deck"
	water="var(--water-deck)"
>
	<Fragment slot="surface">
		<PageHead title={page.title} intro={page.description} />
		<div class="about">
			<section class="part who">
				<Reading>
					<Content />
				</Reading>
				<div class="kit">
					<div>
						<h2>{page.languagesHeading}</h2>
						<ul class="languages">
							{
								page.languages.map((language) => (
									<li>
										<span>{language.name}</span>
										{/* The bar is decoration; the word beside it says the same thing. */}
										<span class="bar" aria-hidden="true">
											<span style={`width: ${(language.score / 5) * 100}%`} />
										</span>
										<span class="level">{language.level}</span>
									</li>
								))
							}
						</ul>
					</div>
					<div>
						<h2>{page.interestsHeading}</h2>
						<ul class="chips">{page.interests.map((interest) => <li>{interest}</li>)}</ul>
						{page.interestsNote && <p class="note">{page.interestsNote}</p>}
					</div>
				</div>
			</section>

			<section class="part">
				<div class="part-head">
					<h2 class="part-title">{page.doneHeading}</h2>
					<p class="intro">{page.doneIntro}</p>
				</div>
				<ChapterTimeline chapterLink={site.chapterLink} />
			</section>

			<p class="closing">{page.closing}</p>
		</div>
	</Fragment>
</BaseLayout>

<style>
	.about {
		display: grid;
		gap: var(--space-huge);
		max-width: var(--wide-length);
	}

	/* On wide screens the languages and interests sit beside the writing rather than under
	   it, while the writing keeps its comfortable reading width. */
	@media (min-width: 60em) {
		.who {
			grid-template-columns: minmax(0, var(--line-length)) minmax(16rem, 24rem);
			justify-content: space-between;
			column-gap: var(--space-large);
		}

		.who .kit {
			grid-template-columns: 1fr;
			align-content: start;
		}
	}

	.part {
		display: grid;
		gap: var(--space-large);
	}

	.part-head {
		display: grid;
		gap: var(--space-small);
		max-width: var(--line-length);
	}

	.part-title {
		font-size: var(--size-stop);
		line-height: 1.1;
	}

	.intro {
		font-size: var(--size-text);
	}

	/* Languages and interests sit side by side on a computer and stack on a phone. */
	.kit {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
		gap: var(--space-large);
	}

	.kit h2 {
		margin-bottom: var(--space-small);
		font-family: var(--font-text);
		font-size: var(--size-small);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.languages {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	.languages li {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr) 6.5rem;
		gap: 0.75rem;
		align-items: center;
	}

	.bar {
		height: 6px;
		border-radius: 3px;
		background: var(--colour-on-sky-line);
		overflow: hidden;
	}

	.bar span {
		display: block;
		height: 100%;
		background: var(--colour-on-sky);
	}

	.level,
	.note,
	.closing {
		color: var(--colour-on-sky-soft);
	}

	.level,
	.note {
		font-size: var(--size-small);
	}

	.chips {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-tiny);
	}

	.chips li {
		padding: 0.2em 0.8em;
		border: 1.5px solid var(--colour-on-sky-line);
		border-radius: 999px;
	}

	.note {
		margin-top: var(--space-small);
	}
</style>
