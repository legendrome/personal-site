---
// Almost nothing on the page, and the boat far away, because the emptiness is the joke.
import { getEntry } from 'astro:content';
import PageHead from '../components/PageHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const { data: site } = await getEntry('site', 'site');
---

<BaseLayout title={`${site.lostTitle} | ${site.name}`} opening="deck" water="var(--water-deck)" adrift>
	<Fragment slot="surface">
		<PageHead title={site.lostTitle} intro={site.lostLine}>
			<p><a href="/">{site.lostLink}</a></p>
		</PageHead>
	</Fragment>
</BaseLayout>

<style>
	a {
		color: inherit;
		font-weight: 500;
		text-underline-offset: 4px;
	}
</style>
