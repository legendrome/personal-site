---
// Still a placeholder: it shows the look on a real page. The proper home page,
// with words from src/content/, replaces it in Phase 3.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Sujith Bandaru">
	<div slot="surface" class="hello">
		<h1>Sujith Bandaru</h1>
		<p class="intro">I’ve never liked the phrase ‘not in the same boat’. Why can’t I just invite you onto mine?</p>
	</div>

	<div class="dive">
		<h2>THIS SITE IS GOING TO ROCK</h2>
	</div>
</BaseLayout>

<style>
	.hello {
		display: grid;
		gap: var(--space-medium);
		padding-block: var(--space-huge) 0;
	}

	.intro {
		font-size: var(--size-intro);
		line-height: 1.35;
	}

	/* The page has little on it yet, so this gives the dive room to scroll. */
	.dive {
		min-height: 150svh;
		padding-block: var(--space-huge);
	}
</style>
