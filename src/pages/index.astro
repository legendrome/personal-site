---
// The home page is the pitch, told as one dive through the ocean's real zones. Each zone
// holds a short preview of one part of the site and links on to its full page: what
// Sujith has done first, because that is what most visitors came for, then where he has
// been, then his writing, then the sea floor with how to reach him. All the words come
// from src/content/.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';
import { sunrays } from '../lib/sunrays';
import AnchorLine from '../components/AnchorLine.astro';
import ArrowRow from '../components/ArrowRow.astro';
import ButtonLink from '../components/ButtonLink.astro';
import DepthGauge from '../components/DepthGauge.astro';
import DiveScenery from '../components/DiveScenery.astro';
import ProofCard from '../components/ProofCard.astro';
import VoyageMap from '../components/VoyageMap.astro';
import SeaFloor from '../components/SeaFloor.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	formatDate,
	getChapters,
	getFeaturedExperience,
	getPosts,
	getProjects,
} from '../lib/content';

const { data: site } = await getEntry('site', 'site');
const chapters = await getChapters();
const projects = (await getProjects()).filter((project) => project.data.featured);
const proof = await getFeaturedExperience();
const { data: about } = await getEntry('about', 'about');
// The university comes from the degree's own file, so it is written in one place.
const degree = await getEntry('experience', 'warwick-degree');

// Facts about Sujith in a form search engines read, so a search for his name can show his
// photo, university and profiles. "Structured data", in the vocabulary from schema.org.
// Every fact comes from the site's own content files.
const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	url: Astro.site?.href,
	image: new URL(portrait.src, Astro.site).href,
	description: site.heroLine,
	alumniOf: degree?.data.organisation
		? { '@type': 'CollegeOrUniversity', name: degree.data.organisation }
		: undefined,
	knowsLanguage: about.languages.map((language) => language.name),
	sameAs: [site.linkedin, site.github].filter(Boolean),
};
const latestPost = (await getPosts())[0];
---

<BaseLayout title={site.name}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
	{/* The sun, a quarter of it in the corner. The menu's About link sits on it, and the
	   photo under it links to About too.
	   Its rays cross the sky here and carry on into the water in DiveScenery.astro. */}
	<div slot="surface" class="sunlight" aria-hidden="true">
		<svg viewBox="0 0 100 100" preserveAspectRatio="none">
			{sunrays.map(([left, right]) => <path d={`M100 0 L${left} 100 L${right} 100 Z`} />)}
		</svg>
	</div>
	<div slot="surface" class="sun" data-sun>
		<span class="disc" aria-hidden="true"></span>
	</div>
	<a slot="surface" class="portrait" href="/about">
		<Image src={portrait} alt={site.portraitAlt} width={240} height={240} loading="eager" />
	</a>

	<div slot="surface" class="hello">
		<h1>{site.name}</h1>
		<div class="who">
			<p class="intro">{site.heroLine}</p>
			<p class="boat-line">{site.firstLine}</p>
			<div class="actions">
				{site.linkedin && <ButtonLink href={site.linkedin} kind="main">{site.contactLabel}</ButtonLink>}
				<ButtonLink href="#journey">{site.diveLabel}</ButtonLink>
			</div>
		</div>
		<section class="glance" aria-labelledby="glance-heading">
			<h2 id="glance-heading">{site.glanceHeading}</h2>
			<ul>
				{
					site.glance.map((item) => (
						<li>{item.href ? <a href={item.href}>{item.text}</a> : item.text}</li>
					))
				}
			</ul>
		</section>
	</div>

	<section class="section zone" id="journey" data-zone={site.workZone}>
		<p class="zone-name">{site.workZone}</p>
		<h2>{site.proofHeading}</h2>
		<div class="cards">
			{proof.map((entry) => <ProofCard entry={entry} />)}
		</div>
		{
			projects.length > 0 && (
				<>
					<h3 class="sub">{site.projectsHeading}</h3>
					<div class="rows">
						{projects.map((project) => (
							<ArrowRow
								href={`/work/${project.id}`}
								title={project.data.title}
								detail={project.data.summary}
							/>
						))}
					</div>
				</>
			)
		}
		<p class="onward"><a href="/work">{site.allWork}</a></p>
	</section>

	<section class="section zone" data-zone={site.journeyZone}>
		<p class="zone-name">{site.journeyZone}</p>
		<h2>{site.journeyHeading}</h2>
		<p class="lead">{site.pinnedSentence}</p>
		<div class="map">
			<VoyageMap chapters={chapters} />
		</div>
		<p class="onward"><a href="/journey">{site.journeyLink}</a></p>
	</section>

	{
		latestPost && (
			<section class="section zone" data-zone={site.writingZone}>
				<p class="zone-name">{site.writingZone}</p>
				<h2>{site.writingHeading}</h2>
				<div class="rows">
					<ArrowRow
						href={`/writing/${latestPost.id}`}
						title={latestPost.data.title}
						detail={formatDate(latestPost.data.date)}
					/>
				</div>
				<p class="onward"><a href="/writing">{site.allWriting}</a></p>
			</section>
		)
	}

	<section class="section floor" data-zone={site.floorZone}>
		<h2>{site.floorHeading}</h2>
		<p>{site.floorLine}</p>
		{
			site.linkedin && (
				<div class="lure-row">
					<ButtonLink href={site.linkedin} kind="main">{site.contactLabel}</ButtonLink>
					{/* An anglerfish, whose glowing lure hangs beside the button: in the dark of
					    the deep sea, the one light is the one thing to follow. Scenery only. */}
					<svg class="angler" viewBox="0 0 140 110" aria-hidden="true">
						<path class="rod" d="M70 40 C 60 10, 30 6, 14 22"></path>
						<circle class="lure" cx="12" cy="28" r="6"></circle>
						<path
							class="body"
							d="M40 66 C 40 40, 66 30, 92 36 C 112 40, 124 56, 132 50 C 136 62, 136 76, 132 86 C 124 80, 112 92, 92 94 C 64 98, 40 90, 40 66 Z"
						></path>
						<path class="mouth" d="M42 70 C 54 64, 66 66, 74 74 C 64 82, 52 82, 42 70 Z"></path>
						<path class="teeth" d="M48 68 l3 5 l3 -5 l3 5 l3 -5 l3 5 l3 -5"></path>
						<circle class="eye" cx="70" cy="52" r="5"></circle>
					</svg>
				</div>
			)
		}
	</section>

	<div slot="at-waterline" class="rope-to-hull" aria-hidden="true"></div>
	<AnchorLine slot="underwater" />
	<DiveScenery slot="underwater" />
	<DepthGauge slot="overlay" surface={site.surfaceZone} />
	<SeaFloor slot="seafloor" />
</BaseLayout>

<script>
	// Tells the header when the sun is on screen, so About can turn amber while it sits on it.
	const sun = document.querySelector('[data-sun]');
	if (sun) {
		new IntersectionObserver(([entry]) => {
			document.documentElement.classList.toggle('sun-in-view', entry.isIntersecting);
		}).observe(sun);
	}
</script>

<script>
	// Remembers how far down the page you were when you left, and goes back there when
	// you return with "Back to the dive". Any other way here, such as clicking the name
	// in the header, still starts at the boat. See src/components/BackToDive.astro.
	try {
		if (sessionStorage.getItem('returning-to-dive')) {
			sessionStorage.removeItem('returning-to-dive');
			const top = Number(sessionStorage.getItem('dive-position'));
			// Instant, because smooth scrolling would replay the whole dive to get there.
			scrollTo({ top, behavior: 'instant' });
		}
		addEventListener('pagehide', () => sessionStorage.setItem('dive-position', String(scrollY)));
	} catch {
		// Storage is blocked, so the home page simply opens at the boat.
	}
</script>

<style>
	/* The anchor line starts where the water does, which is a little below the waves. This
	   short piece sits in the sky's part of the page and ties it up to the boat's hull. */
	.rope-to-hull {
		position: absolute;
		z-index: 3;
		left: calc(12% + var(--boat-width) / 2 - 1px);
		bottom: var(--waterline-overlap);
		width: var(--line-thin);
		height: var(--space-medium);
		background: var(--colour-rope);
	}

	/* The sun's visible quarter. Everything outside this box is cut off, so the full circle
	   never makes the page scroll sideways. */
	.sun {
		position: absolute;
		/* In front of the solid bar behind the header, behind the header's links, so About
		   shows on top of the sun. The photo sits below the menu row, so it can be clicked. */
		z-index: 4;
		top: 0;
		right: 0;
		width: var(--sun-size);
		height: var(--sun-size);
		overflow: hidden;
		pointer-events: none;
	}

	.disc {
		position: absolute;
		top: calc(var(--sun-size) * -1);
		right: calc(var(--sun-size) * -1);
		width: calc(var(--sun-size) * 2);
		height: calc(var(--sun-size) * 2);
		border-radius: 50%;
		background: var(--colour-sun);
		box-shadow: 0 0 0 calc(var(--sun-size) * 0.12) var(--colour-sun-halo);
	}

	/* The photo, tucked into the top-right corner of the sun, to the right of About. It is
	   its own layer above the header, which is see-through there, so it can be clicked. */
	.portrait {
		position: absolute;
		z-index: 6;
		top: calc(var(--sun-size) * 0.04);
		right: calc(var(--sun-size) * 0.04);
		width: calc(var(--sun-size) * 0.5);
	}

	.portrait img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 0 0 3px var(--colour-sun-halo);
	}

	/* On a phone the sun is small and About fills its top edge, so the photo drops just
	   below the menu row, still in the sun's corner. */
	@media (width < 48em) {
		.portrait {
			top: calc(var(--header-height) - var(--space-tiny));
			width: calc(var(--sun-size) * 0.4);
		}
	}

	/* Rays across the sky from the sun's corner, faint, behind the text. */
	.sunlight {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	.sunlight svg {
		width: 100%;
		height: 100%;
		fill: var(--colour-sunlight);
		/* Even strength all the way down the sky, so each ray meets its continuation in the
		   water at the same brightness. The water half does the fading. */
		opacity: 0.45;
	}

	@media (prefers-reduced-motion: no-preference) {
		.sunlight svg path {
			animation: sun-shimmer 8s ease-in-out infinite alternate;
		}

		.sunlight svg path:nth-child(2n) {
			animation-duration: 11s;
			animation-delay: -4s;
		}

		@keyframes sun-shimmer {
			from {
				opacity: 0.5;
			}

			to {
				opacity: 1;
			}
		}
	}

	/* The first screen. On a phone everything stacks; from laptop width the facts sit in a
	   panel to the right of the name, so the whole first impression fits on one screen. */
	.hello {
		display: grid;
		gap: var(--space-large);
		padding-block: var(--space-large) var(--space-medium);
	}

	/* Keeps the name clear of the photo in the sun, wrapping it sooner if it would reach. */
	.hello h1 {
		padding-right: calc(var(--sun-size) * 0.55);
	}

	.who {
		display: grid;
		gap: var(--space-medium);
		align-content: start;
	}

	.intro {
		font-size: var(--size-intro);
		line-height: 1.35;
		font-weight: 500;
	}

	.boat-line {
		color: var(--colour-on-sky-soft);
		font-style: italic;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-small);
		margin-top: var(--space-tiny);
	}

	.glance {
		align-self: end;
		max-width: 26rem;
		padding: var(--space-medium);
		border-radius: var(--radius);
		background: var(--colour-water-deep);
		color: var(--colour-on-water);
	}

	.glance h2 {
		font-family: var(--font-text);
		font-size: var(--size-small);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.glance ul {
		display: grid;
		gap: var(--space-small);
		margin: var(--space-small) 0 0;
		padding: 0;
		list-style: none;
	}

	.glance li {
		padding-left: var(--space-small);
		border-left: var(--line-thin) solid var(--colour-accent);
		line-height: 1.4;
	}

	.glance a {
		text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
	}

	/* From laptop width the name runs across the top, with the sentence and buttons on the
	   left and the facts on the right, so the boat and the waves still show below them. */
	@media (min-width: 60em) {
		.hello {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			column-gap: var(--space-large);
			row-gap: var(--space-medium);
			align-items: end;
		}

		.hello h1 {
			grid-column: 1 / -1;
		}
	}

	.section {
		padding-block: var(--space-huge);
	}

	.zone {
		display: grid;
		/* minmax(0, 1fr) lets the column shrink to the screen, so the cards can wrap. */
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-medium);
		/* "Start the dive" jumps to the first zone; this keeps the fixed header off it. */
		scroll-margin-top: var(--header-height);
	}

	/* The small label naming the ocean zone, like the depth markings on a diver's line. */
	.zone-name {
		font-size: var(--size-small);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.lead {
		font-size: var(--size-intro);
		line-height: 1.35;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: var(--space-small);
		max-width: var(--wide-length);
		margin-top: var(--space-small);
	}

	.sub {
		margin-top: var(--space-large);
		font-size: var(--size-row);
	}

	.map {
		max-width: var(--wide-length);
		margin-block: var(--space-medium);
	}

	.onward a {
		font-weight: 500;
	}

	.rows {
		display: grid;
		gap: var(--space-medium);
		max-width: var(--list-length);
		margin-top: var(--space-large);
	}

	/* The contact button with the anglerfish's lure glowing beside it. */
	.lure-row {
		display: flex;
		align-items: center;
		gap: var(--space-small);
		margin-top: var(--space-tiny);
	}

	.angler {
		width: clamp(6rem, 12vw, 9rem);
		overflow: visible;
	}

	.angler .body {
		fill: var(--colour-rock);
		stroke: var(--colour-rock-light);
		stroke-width: 2;
	}

	.angler .rod {
		fill: none;
		stroke: var(--colour-rock-light);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.angler .lure {
		fill: var(--colour-accent);
		filter: drop-shadow(0 0 6px var(--colour-accent));
	}

	.angler .mouth {
		fill: var(--colour-water-floor);
	}

	.angler .teeth {
		fill: none;
		stroke: var(--colour-on-water);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.angler .eye {
		fill: var(--colour-on-water);
	}

	@media (prefers-reduced-motion: no-preference) {
		.angler .lure {
			animation: lure-glow 2.4s ease-in-out infinite;
		}

		.angler {
			animation: hover-in-place 6s ease-in-out infinite;
		}

		@keyframes lure-glow {
			0%,
			100% {
				opacity: 0.55;
			}

			50% {
				opacity: 1;
			}
		}

		@keyframes hover-in-place {
			0%,
			100% {
				transform: translateY(0);
			}

			50% {
				transform: translateY(-0.4rem);
			}
		}
	}

	.floor {
		display: grid;
		gap: var(--space-medium);
		padding-bottom: 0;
	}

</style>
