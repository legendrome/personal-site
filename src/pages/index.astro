---
// The home page is the pitch, told as one dive through the ocean's real zones. Each zone
// holds a short preview of one part of the site and links on to its full page: what
// Sujith has done first, because that is what most visitors came for, then where he has
// been, then his writing, then the sea floor with how to reach him. All the words come
// from src/content/.
import { getEntry } from 'astro:content';
import AnchorLine from '../components/AnchorLine.astro';
import ArrowRow from '../components/ArrowRow.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ProofCard from '../components/ProofCard.astro';
import VoyageMap from '../components/VoyageMap.astro';
import SeaFloor from '../components/SeaFloor.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	formatDate,
	getChapters,
	getFeaturedExperience,
	getPosts,
	getProjects,
} from '../lib/content';

const { data: site } = await getEntry('site', 'site');
const chapters = await getChapters();
const projects = (await getProjects()).filter((project) => project.data.featured);
const proof = await getFeaturedExperience();
const latestPost = (await getPosts())[0];
---

<BaseLayout title={site.name}>
	<div slot="surface" class="hello">
		<h1>{site.name}</h1>
		<div class="who">
			<p class="intro">{site.heroLine}</p>
			<p class="boat-line">{site.firstLine}</p>
			<div class="actions">
				{site.linkedin && <ButtonLink href={site.linkedin} kind="main">{site.contactLabel}</ButtonLink>}
				<ButtonLink href="#journey">{site.diveLabel}</ButtonLink>
			</div>
		</div>
		<section class="glance" aria-labelledby="glance-heading">
			<h2 id="glance-heading">{site.glanceHeading}</h2>
			<ul>
				{
					site.glance.map((item) => (
						<li>{item.href ? <a href={item.href}>{item.text}</a> : item.text}</li>
					))
				}
			</ul>
		</section>
	</div>

	<section class="section zone" id="journey">
		<p class="zone-name">{site.workZone}</p>
		<h2>{site.proofHeading}</h2>
		<div class="cards">
			{proof.map((entry) => <ProofCard entry={entry} />)}
		</div>
		{
			projects.length > 0 && (
				<>
					<h3 class="sub">{site.projectsHeading}</h3>
					<div class="rows">
						{projects.map((project) => (
							<ArrowRow
								href={`/work/${project.id}`}
								title={project.data.title}
								detail={project.data.summary}
							/>
						))}
					</div>
				</>
			)
		}
		<p class="onward"><a href="/work">{site.allWork}</a></p>
	</section>

	<section class="section zone">
		<p class="zone-name">{site.journeyZone}</p>
		<h2>{site.journeyHeading}</h2>
		<p class="lead">{site.pinnedSentence}</p>
		<div class="map">
			<VoyageMap chapters={chapters} />
		</div>
		<p class="onward"><a href="/journey">{site.journeyLink}</a></p>
	</section>

	{
		latestPost && (
			<section class="section zone">
				<p class="zone-name">{site.writingZone}</p>
				<h2>{site.writingHeading}</h2>
				<div class="rows">
					<ArrowRow
						href={`/writing/${latestPost.id}`}
						title={latestPost.data.title}
						detail={formatDate(latestPost.data.date)}
					/>
				</div>
				<p class="onward"><a href="/writing">{site.allWriting}</a></p>
			</section>
		)
	}

	<section class="section floor">
		<h2>{site.floorHeading}</h2>
		<p>{site.floorLine}</p>
		{
			site.linkedin && (
				<div class="actions">
					<ButtonLink href={site.linkedin} kind="main">{site.contactLabel}</ButtonLink>
				</div>
			)
		}
	</section>

	<div slot="at-waterline" class="rope-to-hull" aria-hidden="true"></div>
	<AnchorLine slot="underwater" />
	<SeaFloor slot="seafloor" />
</BaseLayout>

<script>
	// Remembers how far down the page you were when you left, and goes back there when
	// you return with "Back to the dive". Any other way here, such as clicking the name
	// in the header, still starts at the boat. See src/components/BackToDive.astro.
	try {
		if (sessionStorage.getItem('returning-to-dive')) {
			sessionStorage.removeItem('returning-to-dive');
			const top = Number(sessionStorage.getItem('dive-position'));
			// Instant, because smooth scrolling would replay the whole dive to get there.
			scrollTo({ top, behavior: 'instant' });
		}
		addEventListener('pagehide', () => sessionStorage.setItem('dive-position', String(scrollY)));
	} catch {
		// Storage is blocked, so the home page simply opens at the boat.
	}
</script>

<style>
	/* The anchor line starts where the water does, which is a little below the waves. This
	   short piece sits in the sky's part of the page and ties it up to the boat's hull. */
	.rope-to-hull {
		position: absolute;
		z-index: 3;
		left: calc(12% + var(--boat-width) / 2 - 1px);
		bottom: var(--waterline-overlap);
		width: var(--line-thin);
		height: var(--space-medium);
		background: var(--colour-rope);
	}

	/* The first screen. On a phone everything stacks; from laptop width the facts sit in a
	   panel to the right of the name, so the whole first impression fits on one screen. */
	.hello {
		display: grid;
		gap: var(--space-large);
		padding-block: var(--space-large) var(--space-medium);
	}

	.who {
		display: grid;
		gap: var(--space-medium);
		align-content: start;
	}

	.intro {
		font-size: var(--size-intro);
		line-height: 1.35;
		font-weight: 500;
	}

	.boat-line {
		color: var(--colour-on-sky-soft);
		font-style: italic;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-small);
		margin-top: var(--space-tiny);
	}

	.glance {
		align-self: end;
		max-width: 26rem;
		padding: var(--space-medium);
		border-radius: var(--radius);
		background: var(--colour-water-deep);
		color: var(--colour-on-water);
	}

	.glance h2 {
		font-family: var(--font-text);
		font-size: var(--size-small);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.glance ul {
		display: grid;
		gap: var(--space-small);
		margin: var(--space-small) 0 0;
		padding: 0;
		list-style: none;
	}

	.glance li {
		padding-left: var(--space-small);
		border-left: var(--line-thin) solid var(--colour-accent);
		line-height: 1.4;
	}

	.glance a {
		text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
	}

	/* From laptop width the name runs across the top, with the sentence and buttons on the
	   left and the facts on the right, so the boat and the waves still show below them. */
	@media (min-width: 60em) {
		.hello {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			column-gap: var(--space-large);
			row-gap: var(--space-medium);
			align-items: end;
		}

		.hello h1 {
			grid-column: 1 / -1;
		}
	}

	.section {
		padding-block: var(--space-huge);
	}

	.zone {
		display: grid;
		/* minmax(0, 1fr) lets the column shrink to the screen, so the cards can wrap. */
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-medium);
		/* "Start the dive" jumps to the first zone; this keeps the fixed header off it. */
		scroll-margin-top: var(--header-height);
	}

	/* The small label naming the ocean zone, like the depth markings on a diver's line. */
	.zone-name {
		font-size: var(--size-small);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.lead {
		font-size: var(--size-intro);
		line-height: 1.35;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: var(--space-small);
		max-width: var(--wide-length);
		margin-top: var(--space-small);
	}

	.sub {
		margin-top: var(--space-large);
		font-size: var(--size-row);
	}

	.map {
		max-width: var(--wide-length);
		margin-block: var(--space-medium);
	}

	.onward a {
		font-weight: 500;
	}

	.rows {
		display: grid;
		gap: var(--space-medium);
		max-width: var(--list-length);
		margin-top: var(--space-large);
	}

	.floor {
		display: grid;
		gap: var(--space-medium);
		padding-bottom: 0;
	}

</style>
