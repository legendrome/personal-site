---
// Life in the water on the way down the home page: the sun's rays carrying on below the
// waves and fading out at different depths within the sunlit zone, a jellyfish glowing in the dark
// middle, and "marine snow", the specks that drift down through the deep ocean, lower
// still. It sits behind the text and screen readers skip it. With reduced motion
// everything stays, still.
import { sunrays } from '../lib/sunrays';
---

<div class="scenery" aria-hidden="true">
	{/* Filled in by the script below, which needs the real sizes of the sky and the
	   sunlit zone to keep each ray on the same line as its half in the sky. */}
	<svg class="rays" data-rays={JSON.stringify(sunrays)}>
		<defs>
			<linearGradient id="ray-fade" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" class="ray-start"></stop>
				<stop offset="1" class="ray-end"></stop>
			</linearGradient>
		</defs>
		<g></g>
	</svg>

	<svg class="jelly" viewBox="0 0 80 140">
		<path class="bell" d="M8 40 C 8 16, 24 4, 40 4 C 56 4, 72 16, 72 40 C 64 44, 56 40, 48 44 C 42 40, 38 40, 32 44 C 24 40, 16 44, 8 40 Z"></path>
		<path class="tentacles" d="M18 44 C 14 70, 24 90, 16 120 M30 46 C 28 76, 36 96, 30 132 M44 46 C 46 74, 38 98, 44 128 M58 44 C 62 72, 54 92, 62 118"></path>
	</svg>

	<div class="snow"></div>
</div>

<script>
	// Each ray is a straight line from the sun, in the page's top-right corner, so its
	// position in the water follows from where it crossed the bottom of the sky. This works
	// that out from the real sizes and draws each ray in two pieces on the same line: one
	// inside the wave at the waterline (cut to the wave's curve, in BaseLayout.astro), and
	// one from there down to the end of the sunlit zone. It redraws when the page resizes.
	const rays = document.querySelector<SVGSVGElement>('svg[data-rays]');
	const sea = rays?.closest<HTMLElement>('.sea');
	const sky = document.querySelector<HTMLElement>('.surface');
	const zone = document.querySelector<HTMLElement>('[data-zone]');
	const wave = document.querySelector<SVGSVGElement>('.wave');

	function draw() {
		if (!rays || !sea || !sky || !zone) return;
		const seaBox = sea.getBoundingClientRect();
		const width = seaBox.width;
		const skyHeight = sky.offsetHeight;
		// The sky and the water overlap a little at the waves; this is where the water starts,
		// measured from the top of the sky.
		const waterTop = sky.getBoundingClientRect().bottom - seaBox.top;
		const start = skyHeight - waterTop;
		const depth = zone.getBoundingClientRect().bottom - seaBox.top;
		const pairs: [number, number, number][] = JSON.parse(rays.dataset.rays ?? '[]');
		// Where a ray edge that crosses the bottom of the sky at "edge" percent is, at a
		// given distance below the top of the sky.
		const x = (edge: number, down: number) => width * (1 + ((edge / 100 - 1) * down) / skyHeight);

		rays.setAttribute('viewBox', `0 0 ${width} ${depth}`);
		rays.setAttribute('width', String(width));
		rays.setAttribute('height', String(depth));
		const group = rays.querySelector('g');
		if (!group) return;
		group.innerHTML = pairs
			.map(([left, right, reach]) => {
				// Each ray fades out at its own depth; the fade runs over the ray's own length.
				const end = (depth * reach) / 100;
				const top = start;
				const bottom = start + end;
				const points = [
					[x(left, top), 0],
					[x(right, top), 0],
					[x(right, bottom), end],
					[x(left, bottom), end],
				];
				return `<polygon points="${points.map((p) => p.join(',')).join(' ')}" fill="url(#ray-fade)" />`;
			})
			.join('');

		// The piece inside the wave, in the wave drawing's own units (1440 wide, 90 tall).
		const waveRays = wave?.querySelector('.wave-rays');
		if (!wave || !waveRays) return;
		const waveBox = wave.getBoundingClientRect();
		const skyTop = sky.getBoundingClientRect().top;
		const waveTop = waveBox.top - skyTop;
		const across = 1440 / width;
		waveRays.innerHTML = pairs
			.map(([left, right]) => {
				const top = waveTop;
				const bottom = waveTop + waveBox.height;
				const points = [
					[x(left, top) * across, 0],
					[x(right, top) * across, 0],
					[x(right, bottom) * across, 90],
					[x(left, bottom) * across, 90],
				];
				return `<polygon points="${points.map((p) => p.join(',')).join(' ')}" />`;
			})
			.join('');
	}

	if (sea) {
		new ResizeObserver(draw).observe(sea);
		draw();
	}
</script>

<style>
	.scenery {
		position: absolute;
		inset: 0;
		/* Behind the text but in front of the water, because the sea is its own layer. */
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}

	/* The sun's rays below the waves, at the sky's strength where they enter the water,
	   fading to nothing at the bottom of the sunlit zone. */
	.rays {
		position: absolute;
		top: 0;
		left: 0;
		overflow: visible;
		/* A little fainter than in the sky, because pale light shows up more on dark water. */
		opacity: 0.3;
	}

	/* The piece of each ray inside the wave, drawn into BaseLayout's wave by the script. */
	:global(.wave-rays) {
		opacity: 0.3;
	}

	:global(.wave-rays polygon) {
		fill: var(--colour-sunlight);
	}

	.ray-start {
		stop-color: var(--colour-sunlight);
	}

	.ray-end {
		stop-color: var(--colour-sunlight);
		stop-opacity: 0;
	}

	/* The jellyfish, glowing faintly, in the darker water partway down. */
	.jelly {
		position: absolute;
		top: 48%;
		right: 7%;
		width: clamp(3rem, 6vw, 5rem);
		filter: drop-shadow(0 0 0.75rem var(--colour-glow));
	}

	.bell {
		fill: color-mix(in srgb, var(--colour-on-water) 22%, transparent);
		stroke: var(--colour-glow);
		stroke-width: 2;
	}

	.tentacles {
		fill: none;
		stroke: var(--colour-glow);
		stroke-width: 2;
		stroke-linecap: round;
	}

	/* Marine snow: two layers of tiny dots, repeated, so it costs one element. */
	.snow {
		position: absolute;
		top: 62%;
		bottom: 0;
		left: 0;
		right: 0;
		background-image:
			radial-gradient(circle, var(--colour-glow) 1px, transparent 1.6px),
			radial-gradient(circle, var(--colour-glow) 0.8px, transparent 1.3px);
		background-size:
			140px 160px,
			90px 110px;
		background-position:
			0 0,
			40px 60px;
		mask-image: linear-gradient(transparent, black 20%, black 80%, transparent);
		opacity: 0.7;
	}

	/* On a phone there is no spare space beside the text, so the jellyfish stays out. */
	@media (width < 48em) {
		.jelly {
			display: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		/* The same timing as the rays in the sky (src/pages/index.astro), so each ray
		   brightens and dims in step above and below the waves. */
		.rays :global(polygon),
		:global(.wave-rays polygon) {
			animation: shimmer 8s ease-in-out infinite alternate;
		}

		.rays :global(polygon:nth-child(2n)),
		:global(.wave-rays polygon:nth-child(2n)) {
			animation-duration: 11s;
			animation-delay: -4s;
		}

		.jelly {
			animation: bob 7s ease-in-out infinite;
		}

		.snow {
			animation: fall 40s linear infinite;
		}

		@keyframes shimmer {
			from {
				opacity: 0.5;
			}

			to {
				opacity: 1;
			}
		}

		/* A pulse up, then a slow sink, the way jellyfish swim. */
		@keyframes bob {
			0%,
			100% {
				transform: translateY(0) scaleY(1);
			}

			20% {
				transform: translateY(-1.5rem) scaleY(0.92);
			}

			60% {
				transform: translateY(-0.5rem) scaleY(1.03);
			}
		}

		@keyframes fall {
			from {
				background-position:
					0 0,
					40px 60px;
			}

			to {
				background-position:
					30px 480px,
					70px 390px;
			}
		}
	}
</style>
