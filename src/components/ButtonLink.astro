---
// A link that looks like a button, for the one or two main actions on a page.
// "main" is the buoy-orange one: use it once per screen, so the eye knows where to go.
// "plain" sits beside it with an outline, in the colour of the text around it.
interface Props {
	href: string;
	kind?: 'main' | 'plain';
}

const { href, kind = 'plain' } = Astro.props;
---

<a href={href} class:list={['button', kind]}><slot /></a>

<style>
	.button {
		display: inline-flex;
		align-items: center;
		/* 44px tall at the smallest, a comfortable size to tap. */
		min-height: 2.75rem;
		padding: var(--space-tiny) var(--space-medium);
		border-radius: var(--radius);
		font-weight: 700;
		text-decoration: none;
		line-height: 1.2;
	}

	.main {
		background: var(--colour-accent);
		color: var(--colour-on-accent);
	}

	.plain {
		color: inherit;
		box-shadow: inset 0 0 0 var(--line-thin) currentColor;
	}

	@media (prefers-reduced-motion: no-preference) {
		.button {
			transition: transform 0.15s ease;
		}

		.button:hover {
			transform: translateY(-2px);
		}
	}
</style>
