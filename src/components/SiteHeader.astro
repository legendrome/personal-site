---
// Looks like one header that never moves. There are really two, one placed inside the
// sky and one inside the water, both fixed to the same spot. The clip-path on those two
// areas in BaseLayout.astro shows each copy only over its own area, so the text changes
// colour exactly at the waterline as you scroll. The script in BaseLayout.astro switches
// off whichever copy is out of sight, so keyboard users meet one set of links.
import { getEntry } from 'astro:content';

interface Props {
	tone: 'sky' | 'water';
}

const { tone } = Astro.props;
const { data: site } = await getEntry('site', 'site');
const path = Astro.url.pathname;
---

<header class:list={['site-header', tone]}>
	<a href="/">{site.name}</a>
	<nav aria-label="Main">
		{
			site.nav.map(({ label, href }) => (
				// A project page counts as being in Work, so Work stays marked there too.
				<a href={href} aria-current={path === href || path.startsWith(`${href}/`) ? 'true' : undefined}>
					{label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 5;
		height: var(--header-height);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-small);
		padding-inline: var(--page-gutter);
		font-weight: 500;
	}

	nav {
		display: flex;
		gap: var(--space-small);
	}

	a {
		/* Taller than the text, so the links are easier to tap on a phone. */
		padding-block: var(--space-tiny);
		color: inherit;
		text-decoration: none;
		white-space: nowrap;
	}

	nav a:hover,
	[aria-current] {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.sky {
		color: var(--colour-on-sky);
	}

	.water {
		color: var(--colour-on-water);
		/* A solid bar painted with the same gradient as the water, lined up with it by the
		   script in BaseLayout.astro, so it hides passing text but blends into the water. */
		background-image: var(--water-gradient);
		background-repeat: no-repeat;
		background-size: 100% var(--sea-height, 100vh);
		background-position: 0 var(--sea-top, 0);
	}

	/* The smallest phones cannot fit the name and three links at the normal size. */
	@media (max-width: 370px) {
		.site-header {
			font-size: var(--size-small);
		}

		nav {
			gap: var(--space-tiny);
		}
	}
</style>
