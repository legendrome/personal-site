---
// Looks like one header that never moves. There are really two, one placed inside the
// sky and one inside the water, both fixed to the same spot. The clip-path on those two
// areas in BaseLayout.astro shows each copy only over its own area, so the text changes
// colour exactly at the waterline as you scroll. The script in BaseLayout.astro switches
// off whichever copy is out of sight, so keyboard users meet one set of links.
import { getEntry } from 'astro:content';

interface Props {
	tone: 'sky' | 'water';
}

const { tone } = Astro.props;
const { data: site } = await getEntry('site', 'site');
const path = Astro.url.pathname;
// On the home page the sky has a sun in its top-right corner (see src/pages/index.astro).
// About, last in the menu, sits on it, and the other links are kept clear of it.
// Both copies of the header on the home page share this layout, so the links sit in exactly
// the same places above and below the waves; only the sky's copy turns About amber.
const sunRoom = path === '/';
---

<header class:list={['site-header', tone, { 'sun-room': sunRoom }]}>
	{/* The way home from every page. The little boat, the same as the site's tab icon, marks
	   it as the site's logo, which people expect to click to get home. */}
	<a href="/" class="home">
		<svg class="boat-mark" viewBox="0 0 120 90" aria-hidden="true">
			<path d="M58 6 V62 H18 Z"></path>
			<path d="M64 18 V62 H98 Z"></path>
			<path d="M6 66 H114 L98 88 H22 Z"></path>
		</svg>
		<span class="full">{site.name}</span>
	</a>
	<nav aria-label="Main">
		{
			site.nav.map(({ label, href }) => (
				// A project page counts as being in Work, so Work stays marked there too.
				<a href={href} aria-current={path === href || path.startsWith(`${href}/`) ? 'true' : undefined}>
					{label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 5;
		height: var(--header-height);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-small);
		padding-inline: var(--page-gutter);
		font-weight: 500;
		/* The bar itself lets clicks through to what is behind it, such as the photo in the
		   home page's sun; only its links catch them. */
		pointer-events: none;
	}

	.site-header a {
		pointer-events: auto;
	}

	nav {
		display: flex;
		gap: var(--space-small);
	}

	a {
		/* Taller than the text, so the links are easier to tap on a phone. */
		padding-block: var(--space-tiny);
		color: inherit;
		text-decoration: none;
		white-space: nowrap;
	}

	nav a:hover,
	[aria-current] {
		text-decoration: underline;
		text-underline-offset: var(--underline-offset);
	}

	.sky {
		color: var(--colour-on-sky);
	}

	.water {
		color: var(--colour-on-water);
	}

	/* A solid bar painted with the same gradient as the water, lined up with it by the
	   script in BaseLayout.astro, so it hides passing text but blends into the water. It
	   only fills in --header-bar-delay (set in tokens.css) below the top of the water: just
	   under the waves there is no text to hide, only the sun's rays entering the water,
	   which the bar would otherwise cut off. --sea-top is how far the water's top is below
	   the screen's top. */
	.water::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: var(--water-gradient);
		background-repeat: no-repeat;
		background-size: 100% var(--sea-height, 100vh);
		background-position: 0 var(--sea-top, 0);
		clip-path: inset(clamp(0px, calc(var(--sea-top, 0px) + var(--header-bar-delay)), 100%) 0 0 0);
	}

	/* Pages that start under water have no waves or rays at the top, so the bar is whole. */
	:global(.no-sky) .water::before {
		clip-path: none;
	}

	.home {
		display: inline-flex;
		align-items: center;
		gap: var(--space-tiny);
	}

	.boat-mark {
		width: 1.6em;
		height: 1.2em;
		fill: currentColor;
	}

	/* Underlines on hover like the other links, so it reads as one of them. */
	.home:hover .full {
		text-decoration: underline;
		text-underline-offset: var(--underline-offset);
	}

	@media (prefers-reduced-motion: no-preference) {
		.boat-mark {
			transition: translate 0.2s ease;
		}

		.home:hover .boat-mark {
			translate: 0 -0.15rem;
		}
	}

	/* About takes a box as wide as the sun, minus the page margin, and sits at its left
	   end, just inside the sun's edge. So About is always on the sun, every other link
	   always stops short of it at any screen width (the box and the sun use the same
	   size), and the gap from Writing stays close to the gaps between the other links.
	   The small inset grows on phones, where the sun's curve is tighter. */
	.sun-room a[href='/about'] {
		flex: 0 0 calc(var(--sun-size) - var(--page-gutter));
		/* The same width again as a minimum, because Firefox can let a link shrink below
		   its flex size, which slid About under the photo. */
		min-width: calc(var(--sun-size) - var(--page-gutter));
		box-sizing: border-box;
		padding-left: clamp(0.5rem, 2.5rem - 4vw, 1rem);
	}

	/* While the sun is on screen, About turns deep amber: it stands apart from the sun and
	   from the navy links. The home page sets sun-in-view. */
	:global(html.sun-in-view) .sky.sun-room a[href='/about'] {
		color: var(--colour-on-sun);
		font-weight: 700;
	}

	/* Beside the sun on a phone, tighter gaps keep every link on one line. */
	@media (width < 48em) {
		.sun-room,
		.sun-room nav {
			gap: var(--space-tiny);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.sun-room a {
			transition: color 0.3s ease;
		}
	}

	@media (width < 48em) {
		.full {
			/* Hidden from sight but still read out, so the link keeps its real name. */
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		/* On a phone the boat alone is the logo, so the four links fit beside it. The name is
		   still read out to screen readers, above. */
		.boat-mark {
			width: 2em;
			height: 1.5em;
		}
	}

	/* The smallest phones cannot fit the boat and four links at the normal size. */
	@media (max-width: 370px) {
		.site-header {
			font-size: var(--size-small);
		}

		.boat-mark {
			width: 1.5em;
			height: 1.1em;
		}

		nav {
			gap: var(--space-tiny);
		}
	}
</style>
