---
// Looks like one header that never moves. There are really two, one placed inside the
// sky and one inside the water, both fixed to the same spot. The clip-path on those two
// areas in BaseLayout.astro shows each copy only over its own area, so the text changes
// colour exactly at the waterline as you scroll. No JavaScript is involved.
interface Props {
	tone: 'sky' | 'water';
}

const { tone } = Astro.props;
---

<header class:list={['site-header', tone]}>
	<div class="inner">
		<a href="/">Sujith Bandaru</a>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 5;
		height: var(--header-height);
		display: flex;
		align-items: center;
		padding-inline: var(--space-small);
		font-weight: 500;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.sky {
		color: var(--colour-on-sky);
	}

	.water {
		color: var(--colour-on-water);
		/* A solid bar painted with the same gradient as the water, lined up with it by the
		   script in BaseLayout.astro, so it hides passing text but blends into the water. */
		background-image: var(--water-gradient);
		background-repeat: no-repeat;
		background-size: 100% var(--sea-height, 100vh);
		background-position: 0 var(--sea-top, 0);
	}
</style>
