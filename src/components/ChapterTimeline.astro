---
// The second part of About: every journey chapter, newest first, with the roles and notes
// from src/content/experience/ hanging under it. It reads the chapters rather than keeping
// its own list, so a new chapter appears here as well as on the home page.
import { render } from 'astro:content';
import { chapterYears, getChapters, getExperience, hasFullChapter } from '../lib/content';

interface Props {
	chapterLink: string;
}

const { chapterLink } = Astro.props;

const chapters = (await getChapters()).reverse();
const timeline = await Promise.all(
	chapters.map(async (chapter) => {
		const entries = await getExperience(chapter.id);
		const rendered = await Promise.all(
			entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
		);
		return { chapter, entries: rendered };
	}),
);
---

<ol class="timeline">
	{
		timeline.map(({ chapter, entries }) => (
			<li class="chapter">
				<div class="side">
					<h3>{chapter.data.title}</h3>
					{chapterYears(chapter) && <span>{chapterYears(chapter)}</span>}
				</div>
				<span class="rope" aria-hidden="true" />
				<div class="story">
					<p class="line">{chapter.data.line}</p>
					{entries.length > 0 && (
						<ul class="entries">
							{entries.map(({ entry, Content }) => (
								<li class:list={['entry', { note: !entry.data.title }]}>
									{entry.data.title && (
										<h4>
											{entry.data.title}
											{entry.data.organisation && <span> · {entry.data.organisation}</span>}
										</h4>
									)}
									{entry.data.when && <span class="when">{entry.data.when}</span>}
									<Content />
								</li>
							))}
						</ul>
					)}
					{/* Only for chapters with nothing else under them, where the link is the next step. */}
					{entries.length === 0 && hasFullChapter(chapter) && (
						<a href={`/journey/${chapter.id}`}>{chapterLink}</a>
					)}
				</div>
			</li>
		))
	}
</ol>

<style>
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
	}

	/* Three columns: chapter name and years, the rope, then the story. */
	.chapter {
		display: grid;
		grid-template-columns: 9rem 1.5rem minmax(0, 1fr);
		column-gap: var(--space-small);
	}

	.side {
		display: grid;
		align-content: start;
		gap: 0.2rem;
		text-align: right;
	}

	.side h3 {
		font-size: var(--size-text);
		line-height: 1.3;
	}

	.side span,
	.when {
		font-size: var(--size-small);
		color: var(--colour-on-sky-soft);
		font-variant-numeric: tabular-nums;
	}

	/* A dashed line with a dot for each chapter, like the anchor line on the home page.
	   The line starts at the first dot and stops at the last, so it never hangs loose. */
	.rope {
		position: relative;
	}

	.rope::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		border-left: 2px dashed var(--colour-on-sky-line);
	}

	.chapter:first-child .rope::before {
		top: 0.6rem;
	}

	.chapter:last-child .rope::before {
		bottom: auto;
		height: 0.6rem;
	}

	.rope::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 0.3rem;
		width: 1rem;
		height: 1rem;
		transform: translateX(-50%);
		border-radius: 50%;
		background: var(--colour-on-sky);
	}

	.story {
		display: grid;
		align-content: start;
		gap: var(--space-medium);
		padding-bottom: var(--space-large);
		min-width: 0;
	}

	.line {
		font-size: var(--size-intro);
		line-height: 1.35;
		font-style: italic;
	}

	.story a {
		color: inherit;
		text-underline-offset: 4px;
	}

	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-medium);
	}

	.entry {
		display: grid;
		gap: 0.3rem;
		max-width: var(--line-length);
		padding-left: var(--space-small);
		border-left: 2px solid var(--colour-on-sky-line);
	}

	/* A note, such as the tools line, is plain text without the role's edge. */
	.note {
		padding-left: 0;
		border-left: 0;
	}

	.entry h4 {
		margin: 0;
		font-family: var(--font-text);
		font-size: var(--size-text);
		line-height: 1.3;
	}

	.entry h4 span {
		font-weight: normal;
		color: var(--colour-on-sky-soft);
	}

	.entry :global(p) {
		margin: 0;
	}

	/* On a phone the chapter name moves above its story, so nothing is squeezed. */
	@media (max-width: 35em) {
		.chapter {
			grid-template-columns: 1.25rem minmax(0, 1fr);
			column-gap: 0.75rem;
		}

		.side {
			grid-column: 2;
			grid-row: 1;
			text-align: left;
			padding-bottom: 0.75rem;
		}

		.rope {
			grid-column: 1;
			grid-row: 1 / span 2;
		}

		.story {
			grid-column: 2;
		}
	}
</style>
