---
// A short stretch of a YouTube video, such as Sujith's high school graduation speech, shown at the end of a
// chapter. The page first shows only a quote and a button, and YouTube loads when someone
// presses it. That keeps the page fast and means YouTube cannot track visitors who never
// watch. It plays from the privacy-enhanced youtube-nocookie.com address, which YouTube
// provides for embedding. Without JavaScript the button is a plain link to the same moment
// on YouTube.
//
// Embedded rather than downloaded, because the recording belongs to whoever uploaded it,
// and embedding is the use YouTube allows.
//
// The optional poster is a screenshot kept in the site, not YouTube's thumbnail, because
// YouTube cannot give the frame at the start time, and loading its thumbnail would reach
// YouTube for every visitor.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	youtube: string;
	start: string;
	end: string;
	label: string;
	quote?: string;
	poster?: ImageMetadata;
}

const { youtube, start, end, label, quote, poster } = Astro.props;

// "42:15" to seconds, which is what YouTube's addresses use.
const seconds = (time: string) => time.split(':').reduce((total, part) => total * 60 + Number(part), 0);
const from = seconds(start);
const to = seconds(end);
const minutes = Math.max(1, Math.round((to - from) / 60));

const watchUrl = `https://www.youtube.com/watch?v=${youtube}&t=${from}s`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${youtube}?start=${from}&end=${to}&autoplay=1&rel=0`;
---

<figure class="video-moment" id="speech">
	{quote && <blockquote>{quote}</blockquote>}
	<div class="frame">
		{/* The label sits under the panel, so the button names itself for screen readers. */}
		<a class:list={['play', { 'has-poster': poster }]} href={watchUrl} data-embed={embedUrl} data-title={label} aria-label={`${label} (${minutes} minutes)`}>
			{/* Empty alt: the label already says what the video is, so describing the still would repeat it. */}
			{poster && <Image class="poster" src={poster} alt="" widths={[640, 1000, 1600]} sizes="(width < 48em) 100vw, 48rem" />}
			<span class="icon" aria-hidden="true"></span>
		</a>
	</div>
	{/* Under the panel rather than on it, so it stays out of the picture and remains after the player loads. */}
	<figcaption>{label} ({minutes} minutes)</figcaption>
</figure>

<script>
	document.querySelectorAll<HTMLAnchorElement>('.video-moment .play').forEach((link) => {
		link.addEventListener('click', (event) => {
			event.preventDefault();
			const player = document.createElement('iframe');
			player.src = link.dataset.embed ?? '';
			player.title = link.dataset.title ?? '';
			player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			player.allowFullscreen = true;
			player.referrerPolicy = 'strict-origin-when-cross-origin';
			link.replaceWith(player);
		});
	});
</script>

<style>
	.video-moment {
		display: grid;
		gap: var(--space-small);
		margin: var(--space-medium) 0 0;
	}

	blockquote {
		margin: 0;
		padding-left: 1em;
		border-left: 3px solid var(--colour-sky);
		font-size: var(--size-intro);
		line-height: 1.3;
	}

	/* Holds the video's shape before and after it loads, so nothing jumps. */
	.frame {
		aspect-ratio: 16 / 9;
		border-radius: var(--radius);
		overflow: hidden;
		background: color-mix(in srgb, var(--colour-sky) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--colour-sky) 35%, transparent);
	}

	.play {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-small);
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		padding: var(--space-small);
		color: inherit;
	}

	/* Faded and small, like the photo captions in chapters, so it reads as a note on the video. */
	figcaption {
		font-size: var(--size-small);
		font-style: italic;
		line-height: 1.5;
		color: color-mix(in srgb, currentColor 75%, transparent);
		/* Avoids a lone word such as "minutes)" on the last line. */
		text-wrap: pretty;
	}

	/* A plain play triangle in a circle, drawn with CSS so there is no image to load. */
	.icon {
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		border: var(--line-thin) solid currentColor;
		background: linear-gradient(currentColor, currentColor) no-repeat 55% 50% / 0 0;
		position: relative;
	}

	.icon::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 54%;
		transform: translate(-50%, -50%);
		border-style: solid;
		border-width: 0.7rem 0 0.7rem 1.15rem;
		border-color: transparent transparent transparent currentColor;
	}

	.play:hover .icon,
	.play:focus-visible .icon {
		background-color: color-mix(in srgb, var(--colour-sky) 20%, transparent);
	}

	/* With a poster, the still fills the panel and the play button sits on top of it. */
	.has-poster {
		position: relative;
		/* Keeps the still and its shading behind the button but inside the panel. */
		isolation: isolate;
		color: var(--colour-on-water);
	}

	.has-poster .poster {
		position: absolute;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.has-poster .icon {
		background-color: color-mix(in srgb, var(--colour-water-floor) 45%, transparent);
	}

	.has-poster:hover .icon,
	.has-poster:focus-visible .icon {
		background-color: color-mix(in srgb, var(--colour-water-floor) 70%, transparent);
	}

	/* :global because the player is added by the script after the page loads, so Astro
	   cannot mark it as belonging here, and a plain "iframe" rule would never reach it. */
	.frame :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
