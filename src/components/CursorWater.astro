---
// Moving the mouse under water feels like moving through water.
//
// In Chrome and Edge, a small lens follows the cursor and ripples whatever is behind it,
// using an SVG "displacement filter" (it shifts each pixel by a wavy amount). The lens is
// kept about 120px across on purpose: the work grows with the area, and at this size any
// recent laptop draws it easily, while a whole page of rippling would stutter. Safari and
// Firefox cannot apply this filter to what is behind an element, so there the cursor leaves
// a short trail of rising bubbles instead.
//
// Only below the waterline, only with a mouse (phones have no cursor), never for visitors
// whose device asks for less motion, never in the way of a click, and skipped by screen
// readers. It fades out when the mouse stops, so it never sits on top of what you read.
---

<div class="cursor-water" aria-hidden="true" hidden>
	<svg class="defs" width="0" height="0">
		<filter id="water-lens" x="0" y="0" width="100%" height="100%">
			<feTurbulence type="fractalNoise" baseFrequency="0.018 0.03" numOctaves="2" seed="3" result="noise">
				<animate attributeName="baseFrequency" dur="7s" values="0.018 0.03;0.024 0.036;0.018 0.03" repeatCount="indefinite" />
			</feTurbulence>
			<feDisplacementMap in="SourceGraphic" in2="noise" scale="16" xChannelSelector="R" yChannelSelector="G" />
		</filter>
	</svg>
	<div class="lens"></div>
	<div class="bubbles"></div>
</div>

<script>
	const root = document.querySelector<HTMLElement>('.cursor-water');
	const lens = root?.querySelector<HTMLElement>('.lens');
	const bubbles = root?.querySelector<HTMLElement>('.bubbles');
	const sea = document.querySelector<HTMLElement>('.sea');
	const mouse = matchMedia('(hover: hover) and (pointer: fine)');
	const calm = matchMedia('(prefers-reduced-motion: reduce)');
	// Only Chromium browsers (Chrome, Edge) can ripple what is behind an element, and only
	// they report userAgentData, so it doubles as the test.
	const canRipple = 'userAgentData' in navigator;

	if (root && lens && bubbles && sea && mouse.matches && !calm.matches) {
		root.hidden = false;
		root.classList.add(canRipple ? 'ripple' : 'trail');

		let x = 0;
		let y = 0;
		let lensX = 0;
		let lensY = 0;
		let lastBubbleX = 0;
		let lastBubbleY = 0;
		let idle = 0;
		let running = false;

		const underwater = (clientY: number) => clientY > sea.getBoundingClientRect().top;

		// The lens trails the cursor a little, easing towards it, which reads as moving
		// through something thicker than air.
		function frame() {
			lensX += (x - lensX) * 0.18;
			lensY += (y - lensY) * 0.18;
			lens!.style.translate = `${lensX}px ${lensY}px`;
			if (Math.abs(x - lensX) + Math.abs(y - lensY) > 0.5) {
				requestAnimationFrame(frame);
			} else {
				running = false;
			}
		}

		function bubble(atX: number, atY: number) {
			// A few at a time is plenty; the oldest go first.
			if (bubbles!.childElementCount > 14) bubbles!.firstElementChild?.remove();
			const dot = document.createElement('span');
			dot.style.left = `${atX + (Math.random() * 10 - 5)}px`;
			dot.style.top = `${atY}px`;
			dot.style.setProperty('--size', `${4 + Math.random() * 5}px`);
			dot.addEventListener('animationend', () => dot.remove());
			bubbles!.append(dot);
		}

		addEventListener(
			'pointermove',
			(event) => {
				if (event.pointerType !== 'mouse') return;
				x = event.clientX;
				y = event.clientY;
				const inWater = underwater(y);
				root.classList.toggle('active', inWater);
				clearTimeout(idle);
				idle = window.setTimeout(() => root.classList.remove('active'), 1200);
				if (!inWater) return;

				if (canRipple) {
					if (!running) {
						running = true;
						requestAnimationFrame(frame);
					}
				} else if (Math.hypot(x - lastBubbleX, y - lastBubbleY) > 35) {
					lastBubbleX = x;
					lastBubbleY = y;
					bubble(x, y);
				}
			},
			{ passive: true },
		);

		document.addEventListener('pointerleave', () => root.classList.remove('active'));
	}
</script>

<style>
	.cursor-water {
		position: fixed;
		inset: 0;
		z-index: 7;
		pointer-events: none;
		overflow: hidden;
	}

	.defs {
		position: absolute;
	}

	/* The lens: centred on its position, invisible until the mouse moves under water. A thin
	   pale rim and a soft highlight make it read as a drop of water, even before the ripple. */
	.lens {
		position: absolute;
		top: -3.75rem;
		left: -3.75rem;
		width: 7.5rem;
		height: 7.5rem;
		border-radius: 50%;
		box-shadow:
			inset 0 0 0 1px var(--colour-glow),
			inset 0.4rem 0.6rem 1.2rem -0.6rem var(--colour-glow);
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.ripple .lens {
		backdrop-filter: url(#water-lens);
	}

	.trail .lens {
		display: none;
	}

	.ripple.active .lens {
		opacity: 1;
	}

	/* The fallback: bubbles that wobble upward from the cursor and fade. */
	.bubbles :global(span) {
		position: absolute;
		width: var(--size);
		height: var(--size);
		border-radius: 50%;
		box-shadow: inset 0 0 0 1.5px var(--colour-glow);
		animation: cursor-bubble 1.1s ease-out forwards;
	}

	@keyframes cursor-bubble {
		from {
			opacity: 0.9;
			transform: translate(0, 0) scale(0.6);
		}

		to {
			opacity: 0;
			transform: translate(0.5rem, -3.5rem) scale(1);
		}
	}
</style>
