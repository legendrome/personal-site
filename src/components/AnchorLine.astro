---
// An anchor that drops as you scroll: it holds its place on screen while the rope pays out
// behind it, until it lands on the sea floor. Scrolling back up raises it again. This is all
// done by position: sticky, so it needs no JavaScript. It runs down the page's side margin,
// sized from --page-gutter so it keeps clear of the text at every screen width. It is pure
// decoration, so screen readers skip it. The curve stretches to fit, which is why its line
// uses non-scaling-stroke: that keeps the rope the same thickness all the way down.
---

<div class="anchor-line" aria-hidden="true">
	<svg class="from-boat" viewBox="0 0 100 100" preserveAspectRatio="none">
		<path d="M100 0 C100 55 0 45 0 100" vector-effect="non-scaling-stroke"></path>
	</svg>
	<div class="drop">
		<div class="weight">
			<svg class="anchor" viewBox="0 0 40 50">
				<circle cx="20" cy="6" r="4"></circle>
				<path d="M20 10 V46 M11 18 H29 M4 30 C5 40 11 46 20 46 C29 46 35 40 36 30"></path>
			</svg>
		</div>
	</div>
</div>

<style>
	.anchor-line {
		position: absolute;
		inset: 0;
		pointer-events: none;
		/* Everything is a share of the margin, so the gap to the text grows with the screen. */
		--rope-left: calc(var(--page-gutter) * 0.35);
		--anchor-width: calc(var(--page-gutter) * 0.55);
		--anchor-height: calc(var(--anchor-width) * 1.25);
		/* How far above the bottom of the page it comes to rest, on the sand. */
		--anchor-rest: var(--space-medium);
	}

	svg {
		display: block;
		overflow: visible;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* From under the boat's hull across to the margin. Lined up with the boat in BaseLayout.astro. */
	.from-boat {
		position: absolute;
		top: 0;
		left: var(--rope-left);
		width: calc(12% + var(--boat-width) / 2 - var(--rope-left));
		height: var(--space-huge);
		stroke: var(--colour-rope);
		stroke-width: 2;
	}

	/* The whole fall, from the end of the curve to the sand. Clipping it stops the rope drawn
	   on the weight showing above the curve. "clip" rather than "hidden", because "hidden"
	   would stop the sticky position below from working. */
	.drop {
		position: absolute;
		top: var(--space-huge);
		bottom: var(--anchor-rest);
		left: 0;
		width: var(--page-gutter);
		overflow: clip;
	}

	/* Holds near the bottom edge of the screen, which makes it look as if it leads the way
	   down. That exact height means it touches the sand just as the page ends. A height any
	   further up would leave it hanging in the water at the bottom of the page. */
	.weight {
		position: sticky;
		top: calc(100dvh - var(--anchor-height) - var(--anchor-rest));
	}

	/* The rope hangs above the anchor and only has to reach past the top of the screen. */
	.weight::before {
		content: '';
		position: absolute;
		bottom: 100%;
		left: calc(var(--rope-left) - 1px);
		width: 2px;
		height: 100lvh;
		background: var(--colour-rope);
	}

	/* Moved across so the ring sits on the end of the rope. */
	.anchor {
		margin-left: calc(var(--rope-left) - var(--anchor-width) / 2);
		width: var(--anchor-width);
		height: var(--anchor-height);
		stroke: var(--colour-on-water);
		stroke-width: 3;
	}
</style>
