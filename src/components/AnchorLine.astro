---
// An anchor that drops as you scroll: it holds its place on screen while the rope pays out
// behind it, until it lands on the sea floor. Scrolling back up raises it again. This is all
// done by position: sticky, so it needs no JavaScript. It runs down the gutter left of the
// text, so it can never cross any words, at any screen width. It is pure decoration, so
// screen readers skip it. The curve stretches to fit, which is why its line uses
// non-scaling-stroke: that keeps the rope the same thickness all the way down.
---

<div class="anchor-line" aria-hidden="true">
	<svg class="from-boat" viewBox="0 0 100 100" preserveAspectRatio="none">
		<path d="M100 0 C100 55 0 45 0 100" vector-effect="non-scaling-stroke"></path>
	</svg>
	<svg class="seabed" viewBox="0 0 1440 60" preserveAspectRatio="none">
		<path d="M0 26 C 200 8, 420 38, 700 24 S 1180 6, 1440 30 V60 H0 Z"></path>
	</svg>
	<div class="drop">
		<div class="weight">
			<svg class="anchor" viewBox="0 0 40 50">
				<circle cx="20" cy="6" r="4"></circle>
				<path d="M20 10 V46 M11 18 H29 M4 30 C5 40 11 46 20 46 C29 46 35 40 36 30"></path>
			</svg>
		</div>
	</div>
</div>

<style>
	.anchor-line {
		position: absolute;
		inset: 0;
		pointer-events: none;
		/* The rope runs down the middle of the gutter, and the anchor fits exactly inside it. */
		--rope-left: var(--space-tiny);
		--anchor-width: var(--space-small);
		--anchor-height: 1.25rem;
	}

	svg {
		display: block;
		overflow: visible;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* From under the boat's hull across to the edge. Lined up with the boat in BaseLayout.astro. */
	.from-boat {
		position: absolute;
		top: 0;
		left: var(--rope-left);
		width: calc(12% + var(--boat-width) / 2 - var(--rope-left));
		height: var(--space-huge);
		stroke: var(--colour-rope);
		stroke-width: 2;
	}

	.seabed {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: var(--space-large);
		fill: var(--colour-water-deep);
	}

	/* The whole fall, from the end of the curve to the sea floor. Clipping it stops the rope
	   drawn on the weight showing above the curve. "clip" rather than "hidden", because
	   "hidden" would stop the sticky position below from working. */
	.drop {
		position: absolute;
		top: var(--space-huge);
		bottom: var(--space-tiny);
		left: 0;
		width: var(--anchor-width);
		overflow: clip;
	}

	/* Holds at the bottom edge of the screen, which makes it look as if it leads the way down.
	   That exact height means it touches the sea floor just as the page ends. A height any
	   further up would leave it hanging in the water at the bottom of the page. */
	.weight {
		position: sticky;
		top: calc(100dvh - var(--anchor-height) - var(--space-tiny));
	}

	/* The rope hangs above the anchor and only has to reach past the top of the screen. */
	.weight::before {
		content: '';
		position: absolute;
		bottom: 100%;
		left: calc(var(--rope-left) - 1px);
		width: 2px;
		height: 100lvh;
		background: var(--colour-rope);
	}

	.anchor {
		width: var(--anchor-width);
		height: var(--anchor-height);
		stroke: var(--colour-on-water);
		stroke-width: 4;
	}
</style>
