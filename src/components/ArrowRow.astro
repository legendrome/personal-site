---
// One line in a list of projects or posts, with an arrow that stretches on hover.
interface Props {
	href: string;
	title: string;
	detail: string;
}

const { href, title, detail } = Astro.props;
---

<a class="row" href={href}>
	<div>
		<h3>{title}</h3>
		<p>{detail}</p>
	</div>
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<path class="shaft" d="M 2,12 h 17"></path>
		<path class="tip" d="M 12,5 l 7,7 l -7,7"></path>
	</svg>
</a>

<style>
	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-small);
		color: inherit;
		text-decoration: none;
	}

	h3 {
		font-size: var(--size-row);
		line-height: 1.2;
	}

	svg {
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Browsers that cannot animate a path's shape just keep the arrow still. */
	@media (prefers-reduced-motion: no-preference) {
		.shaft,
		.tip {
			transition: d 240ms cubic-bezier(0.3, 1.6, 0.6, 1);
		}

		.row:hover .shaft,
		.row:focus-visible .shaft {
			d: path('M 2,12 h 20');
		}

		.row:hover .tip,
		.row:focus-visible .tip {
			d: path('M 16,7 l 6,5 l -6,5');
		}
	}
</style>
