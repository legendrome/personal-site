---
// The title block at the top of every inner page.
import BackToDive from './BackToDive.astro';

interface Props {
	title: string;
	intro?: string;
	// A smaller title, for posts and projects, whose titles can be long.
	small?: boolean;
	// For About, Work, Writing and Journey: the page name becomes a small label and the
	// intro becomes the headline. With a giant one-word title on all of them, they read like
	// a template; leading with each page's own sentence makes them differ by what they say.
	// The headline is the h1, the page's main heading, because it is what the page is about;
	// the browser tab and search results still carry the page name.
	labelled?: boolean;
	// The link back up. Left off the page-not-found page, which has its own way back. A
	// chapter passes its own, back to the Journey page, instead of the default home link.
	back?: boolean | { href: string; label: string };
}

const { title, intro, small = false, labelled = false, back = true } = Astro.props;
const backLink = typeof back === 'object' ? back : undefined;
---

<div class="head">
	{backLink ? <a class="back" href={backLink.href}>{backLink.label}</a> : back && <BackToDive />}
	{
		labelled && intro ? (
			<>
				<p class="label">{title}</p>
				<h1 class="headline">{intro}</h1>
			</>
		) : (
			<>
				<h1 class:list={{ small }}>{title}</h1>
				{intro && <p class="intro">{intro}</p>}
			</>
		)
	}
	<slot />
</div>

<style>
	.head {
		display: grid;
		gap: var(--space-medium);
		padding-block: var(--space-large);
	}

	.back {
		justify-self: start;
		font-weight: 500;
	}

	.small {
		font-size: var(--size-chapter);
	}

	.label {
		font-family: var(--font-text);
		font-size: var(--size-small);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.intro {
		font-size: var(--size-intro);
		line-height: 1.35;
	}

	/* The label sits close above its headline, so the two read as one block. */
	.label + .headline {
		margin-top: calc(var(--space-medium) * -0.6);
	}

	.headline {
		max-width: 16em;
		font-family: var(--font-title);
		font-size: var(--size-chapter);
		font-weight: 800;
		line-height: 1.1;
	}
</style>
