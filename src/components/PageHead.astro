---
// The title block at the top of every inner page.
interface Props {
	title: string;
	intro?: string;
	// A smaller title, for posts and projects, whose titles can be long.
	small?: boolean;
}

const { title, intro, small = false } = Astro.props;
---

<div class="head">
	<h1 class:list={{ small }}>{title}</h1>
	{intro && <p class="intro">{intro}</p>}
	<slot />
</div>

<style>
	.head {
		display: grid;
		gap: var(--space-medium);
		padding-block: var(--space-huge) var(--space-large);
	}

	.small {
		font-size: var(--size-chapter);
	}

	.intro {
		font-size: var(--size-intro);
		line-height: 1.35;
	}
</style>
