---
// The title block at the top of every inner page.

interface Props {
	title: string;
	intro?: string;
	// A smaller title, for posts and projects, whose titles can be long.
	small?: boolean;
	// For About, Work, Writing and Journey: the page name becomes a small label and the
	// intro becomes the headline. With a giant one-word title on all of them, they read like
	// a template; leading with each page's own sentence makes them differ by what they say.
	// The headline is the h1, the page's main heading, because it is what the page is about;
	// the browser tab and search results still carry the page name.
	labelled?: boolean;
	// For a page inside a section (a chapter, a project, a post): a small button back up to
	// that section, such as "Journey". Other pages have none, because the name in the menu
	// already goes home on every page.
	back?: { href: string; label: string };
}

const { title, intro, small = false, labelled = false, back } = Astro.props;
---

<div class="head">
	{
		back && (
			<a class="back" href={back.href} aria-label={`Back to ${back.label}`}>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M19 12 H5 M11 6 l-6 6 l6 6"></path>
				</svg>
				{back.label}
			</a>
		)
	}
	{
		labelled && intro ? (
			<>
				<p class="label">{title}</p>
				<h1 class="headline">{intro}</h1>
			</>
		) : (
			<>
				<h1 class:list={{ small }}>{title}</h1>
				{intro && <p class="intro">{intro}</p>}
			</>
		)
	}
	<slot />
</div>

<style>
	.head {
		display: grid;
		gap: var(--space-medium);
		padding-block: var(--space-large);
	}

	/* The way back up to the section, as a small pill with an arrow. It is still a link
	   underneath, because it goes to another page. 44px tall, a comfortable size to tap. */
	.back {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: var(--space-tiny);
		min-height: 2.75rem;
		padding: 0 var(--space-small) 0 0.75rem;
		border-radius: var(--radius-pill);
		box-shadow: inset 0 0 0 var(--line-thin) currentColor;
		font-weight: 700;
		text-decoration: none;
	}

	.back svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (prefers-reduced-motion: no-preference) {
		.back svg {
			transition: translate 0.2s ease;
		}

		.back:hover svg {
			translate: -0.2rem 0;
		}
	}

	.small {
		font-size: var(--size-chapter);
	}

	.label {
		font-family: var(--font-text);
		font-size: var(--size-small);
		font-weight: 700;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}

	.intro {
		font-size: var(--size-intro);
		line-height: 1.35;
	}

	/* The label sits close above its headline, so the two read as one block. */
	.label + .headline {
		margin-top: calc(var(--space-medium) * -0.6);
	}

	.headline {
		max-width: 16em;
		font-family: var(--font-title);
		font-size: var(--size-chapter);
		font-weight: 800;
		line-height: 1.1;
	}
</style>
